{
    "name": "curiosity-path/curiosity-search",
    "description": "Поиск по словоформам для блога: свой индекс основ слов и REST-эндпоинт custom/v1/search",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "wamania/php-stemmer": "^4.0"
    },
    "require-dev": {
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CuriositySearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CuriositySearch\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "analyse": "phpstan analyse --memory-limit=1G",
        "build": "bin/build.sh"
    }
}
