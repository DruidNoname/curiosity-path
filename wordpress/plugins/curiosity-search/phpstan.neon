parameters:
    level: 6
    # на хостинге PHP 8.3 — возможности новее него анализатор считает ошибкой
    phpVersion: 80300
    paths:
        - curiosity-search.php
        - src
    # массивы ответа REST описываются формой ответа, а не PHPDoc-типами
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - identifier: missingType.iterableValue
    bootstrapFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
