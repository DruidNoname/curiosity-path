# Скопируйте в .env.local и подставьте свои значения.
# Все NEXT_PUBLIC_* попадают в клиентский бандл — секретов здесь быть не должно.

# --- Обязательные ---
# Корень WordPress-инсталляции (без хвостового слэша).
NEXT_PUBLIC_WORDPRESS_URL=https://suffer.curiosity-path.ru
# Корень самого фронтенда.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Необязательные ---
# Задавать только если у инсталляции нестандартные пути.
# По умолчанию выводятся из NEXT_PUBLIC_WORDPRESS_URL:
#   API_URL       -> ${NEXT_PUBLIC_WORDPRESS_URL}/wp-json
#   API_BASE      -> ${NEXT_PUBLIC_WORDPRESS_API_URL}/wp/v2
#   ADDON_API_URL -> ${NEXT_PUBLIC_WORDPRESS_API_URL}/custom/v1
#   GRAPHQL_URL   -> ${NEXT_PUBLIC_WORDPRESS_URL}/graphql
#NEXT_PUBLIC_WORDPRESS_API_URL=
#NEXT_PUBLIC_WORDPRESS_API_BASE=
#NEXT_PUBLIC_WORDPRESS_ADDON_API_URL=
#NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=

# --- Метаданные сайта ---
NEXT_PUBLIC_SITE_NAME=Журнал открытой миру
NEXT_PUBLIC_SITE_DESCRIPTION="Путевые заметки мирохода Curiosity"
