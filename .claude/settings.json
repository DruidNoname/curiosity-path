{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "credentials": {
      "files": [
        { "path": ".env", "mode": "deny" },
        { "path": ".env.local", "mode": "deny" },
        { "path": ".env.development.local", "mode": "deny" },
        { "path": ".env.production.local", "mode": "deny" },
        { "path": ".env.production", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "curiosity-path.ru",
        "www.curiosity-path.ru",
        "suffer.curiosity-path.ru"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(yarn test *)",
      "Bash(yarn test)",
      "Bash(yarn lint *)",
      "Bash(yarn lint)",
      "Bash(yarn tsc *)",
      "Bash(yarn build)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Edit(./.env*)"
    ]
  }
}
