# Идеальный .gitignore для Next.js
# Dependencies
node_modules/
.yarn/
.pnp/

# Build
.next/
out/
build/
dist/
*.tsbuildinfo

# Переменные окружения. Игнорируем всё, кроме шаблона без значений.
env/
.env*
*.env
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo

# System
.DS_Store
Thumbs.db

# Ключи, сертификаты, учётные данные
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.npmrc
.netrc
.htpasswd
secrets.json
credentials.json
*service-account*.json

# Привязка к хостингу (содержит идентификаторы проекта и организации)
.vercel/
.netlify/

# Локальные настройки инструментов и агентов.
# CLAUDE.md и .claude/skills/ — общие для команды, они остаются в репозитории.
.claude/settings.local.json
.qwen/
.cursor/
.aider*

# Артефакты слияния и резервные копии — могут содержать куски старых версий файлов
*.orig
*.rej
*.bak
*~

# Optional
.yarnrc.yml
.pnpm-debug.log*
next-env.d.ts
test-connection.js
package-lock.json
schema.graphql
.graphqlrc
